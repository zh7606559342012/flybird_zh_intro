---
import '@fontsource-variable/inter';
---
<style is:inline>
:root {
  --aw-font-sans: 'Inter Variable'; --aw-font-serif: 'Inter Variable'; --aw-font-heading: 'Inter Variable';
  --aw-color-primary: #b8d95a; --aw-color-secondary: #8eaf32; --aw-color-accent: #e39a4f;
  --aw-color-text-heading: #17191b; --aw-color-text-default: #26292b; --aw-color-text-muted: #69706c;
  --aw-color-bg-page: #f5f4ef; --aw-color-bg-page-dark: #151718;
  ::selection { background-color: #b8d95a; color: #17191b; }
}
.dark {
  --aw-color-primary: #b8d95a; --aw-color-secondary: #8eaf32; --aw-color-accent: #e39a4f;
  --aw-color-text-heading: #f5f4ef; --aw-color-text-default: #e6e8e3; --aw-color-text-muted: #a8adaa;
  --aw-color-bg-page: #151718;
  ::selection { background-color: #b8d95a; color: #17191b; }
}
</style>
