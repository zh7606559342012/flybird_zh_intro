      { variant: 'primary', text: '打开数字商品', href: CATEGORY_URL, target: '_blank' },
      { variant: 'secondary', text: '联系 TG 客服', href: TG_BOT, target: '_blank' },
      { variant: 'secondary', text: '加入 TG 频道', href: TG_CHANNEL, target: '_blank' },
    ]}
  />
</Layout>