---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const SHOP_URL = 'https://shop.flybirdhub.top/';
const PRODUCTS_URL = 'https://shop.flybirdhub.top/products';
const TG_BOT = 'https://t.me/stella_cox798_bot';

const metadata = {
  title: 'AI大模型合租拼车 | Flybird购物之家',
  description: 'ChatGPT Plus / Pro 代充、Telegram 会员与销售建站支持，游客可购、自动交付。前往 Flybird购物之家下单。',
};

const products = [
  {
    name: 'gpt_pro20x',
    category: 'ACCOUNT',
    price: '1339.00',
    desc: '下单完，联系 @stella_cox798_bot 获得卡密兑换',
    image: 'https://shop.flybirdhub.top/uploads/product/2026/09/2491f8df-44e4-4c2b-8e97-d0165c0cf44e.png',
    href: PRODUCTS_URL,
    highlight: 'Pro 20X',
  },
  {
    name: 'gpt_pro5x',
    category: 'ACCOUNT',
    price: '749.00',
    desc: '下单完，联系 @stella_cox798_bot 获得卡密兑换',
    image: 'https://shop.flybirdhub.top/uploads/product/2026/09/9456b729-e93d-4d03-86b8-da53d7c95425.png',
    href: PRODUCTS_URL,
    highlight: 'Pro 5X',
  },
  {
    name: 'gpt_plus',
    category: 'ACCOUNT',
    price: '139.00',
    desc: '下单完，联系 @stella_cox798_bot 获得卡密兑换',
    image: 'https://shop.flybirdhub.top/uploads/product/2026/09/214f3988-da9a-47da-8621-9957eab500fd.png',
    href: PRODUCTS_URL,
    highlight: '热销',
  },
  {
    name: 'Telegram会员 3个月',
    category: 'ACCOUNT',
    price: '135.00',
    desc: '如遇支付问题或售后问题，下单后 TG 联系 @stella_cox798_bot',
    image: 'https://shop.flybirdhub.top/uploads/product/2026/08/80dd958f-ad2b-4fa2-95ff-0a4da8cf6574.png',
    href: PRODUCTS_URL,
    highlight: '',
  },
  {
    name: '销售网站建站支持',
    category: 'ACCOUNT',
    price: '16999.00',
    desc: '下单后 TG 联系 @stella_cox798_bot',
    image: 'https://shop.flybirdhub.top/uploads/category/2026/08/15e716d4-1ff0-41c6-a496-bc78c10fe7d5.png',
    href: PRODUCTS_URL,
    highlight: '定制',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Flybird购物之家"
    title="AI大模型合租拼车 · 官方代充商店"
    subtitle="精选 ChatGPT Plus / Pro、Telegram 会员与销售建站支持。游客可购、自动交付、有库存。下单后联系 @stella_cox798_bot 兑换。"
    actions={[
      { variant: 'primary', text: '进入商店下单', href: SHOP_URL, target: '_blank' },
      { variant: 'secondary', text: '查看全部商品', href: PRODUCTS_URL, target: '_blank' },
    ]}
  />

  <Content
    isReversed
    items={[
      {
        title: 'Flybird购物之家',
        description:
          '探索我们精心挑选的优质数字资产系列。畅享 AI 账号代充、Telegram 会员与销售网站建站支持，极速发货，售后走 Telegram 机器人。<br><br>购买入口：<a href="https://shop.flybirdhub.top/" target="_blank" rel="noopener noreferrer">https://shop.flybirdhub.top/</a><br>售后机器人：<a href="https://t.me/stella_cox798_bot" target="_blank" rel="noopener noreferrer">@stella_cox798_bot</a>',
        icon: 'tabler:shopping-bag',
      },
      {
        title: '游客可购 · 自动交付',
        description: '无需先注册也能下单。支付完成后按商品说明联系机器人领取卡密或开通服务。',
        icon: 'tabler:bolt',
      },
      {
        title: '现货有库存',
        description: '当前精选商品均为有库存状态，适合马上开通 Plus / Pro 或补 Telegram 会员。',
        icon: 'tabler:circle-check',
      },
    ]}
    image={{
      src: 'https://shop.flybirdhub.top/uploads/product/2026/09/214f3988-da9a-47da-8621-9957eab500fd.png',
      alt: 'Flybird购物之家精选商品',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">AI大模型合租拼车</h3>
      <p class="mt-2 text-muted">
        原合租介绍页已接入 Flybird 代充商店，下面直接展示店铺精选商品，点击卡片即可去官网购买。
      </p>
    </Fragment>
  </Content>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-3xl font-bold tracking-tight dark:text-white">精选商品</h2>
        <p class="mt-2 text-muted">探索我们精心挑选的优质数字资产系列。</p>
      </div>
      <a
        href={PRODUCTS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-primary hover:underline"
      >
        查看全部商品 →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        products.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900"
          >
            <div class="relative aspect-square overflow-hidden bg-slate-100">
              <img src={item.image} alt={item.name} class="h-full w-full object-cover transition group-hover:scale-105" />
              {item.highlight && (
                <span class="absolute left-3 top-3 rounded-full bg-black/70 px-2.5 py-1 text-xs font-semibold text-white">
                  {item.highlight}
                </span>
              )}
            </div>
            <div class="flex flex-1 flex-col p-4">
              <p class="text-xs uppercase tracking-wide text-slate-400">分类 · {item.category}</p>
              <h3 class="mt-1 text-lg font-bold dark:text-white">{item.name}</h3>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[11px] text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
                  游客可购
                </span>
                <span class="rounded-full bg-sky-50 px-2 py-0.5 text-[11px] text-sky-700 dark:bg-sky-500/10 dark:text-sky-300">
                  自动交付
                </span>
                <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">
                  有库存
                </span>
              </div>
              <p class="mt-3 line-clamp-3 text-sm text-slate-500 dark:text-slate-400">{item.desc}</p>
              <div class="mt-auto flex items-end justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
                <div>
                  <p class="text-xs text-slate-400">价格</p>
                  <p class="text-lg font-bold dark:text-white">
                    {item.price} <span class="text-sm font-medium text-slate-400">CNY</span>
                  </p>
                </div>
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-lg transition group-hover:bg-primary group-hover:text-white dark:border-slate-700">
                  →
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <Features2
    title="为什么从这里买"
    subtitle="把原来的合租介绍，和 Flybird 代充商店的履约方式合在一起。"
    columns={3}
    items={[
      {
        title: 'ChatGPT Plus / Pro',
        description: 'Plus ¥139、Pro 5X ¥749、Pro 20X ¥1339。下单后联系机器人领取卡密兑换。',
        icon: 'tabler:brand-openai',
      },
      {
        title: 'Telegram 会员 3 个月',
        description: '¥135，游客可购、自动交付。支付或售后问题直接找 @stella_cox798_bot。',
        icon: 'tabler:brand-telegram',
      },
      {
        title: '销售网站建站支持',
        description: '¥16999，适合要搭一套销售站的卖家。下单后 Telegram 对接交付。',
        icon: 'tabler:world-www',
      },
    ]}
  />

  <CallToAction
    title="去 Flybird购物之家下单"
    subtitle="商店现货可购。下单完成后，通过 @stella_cox798_bot 兑换卡密或处理售后。"
    actions={[
      { variant: 'primary', text: '打开商店', href: SHOP_URL, target: '_blank' },
      { variant: 'secondary', text: '联系售后机器人', href: TG_BOT, target: '_blank' },
    ]}
  />
</Layout>
