---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'FlyBird 小郑｜海外增长与个人商业合作',
  description: 'FlyBird 小郑，分享海外自媒体、个人商业、数字工具与投资成长经验。',
  ignoreTitleTemplate: true,
};

const services = [
  { number: '01', title: '海外自媒体增长', text: '从选题、脚本、剪辑、频道定位到 YPP 与收款，陪你把内容做成长期资产。', tag: 'YouTube / Shorts / 直播' },
  { number: '02', title: '社群与创业陪跑', text: '进入同频的创业与自媒体社群，持续交流实战经验，少走弯路，找到可复制的增长路径。', tag: '交流 / 复盘 / 资源' },
  { number: '03', title: '数字工具与建站', text: 'AI 工具、账号订阅、个人网站与商业站点搭建，让想法快速上线，建立自己的线上阵地。', tag: 'AI / Web / 产品' },
  { number: '04', title: '个人商业咨询', text: '围绕自由职业、内容变现、海外业务与个人品牌，提供清晰、务实的一对一策略建议。', tag: '1 对 1 / ¥499 起' },
];

const videos = [
  { title: '从 0 到 1 做海外自媒体', text: '定位、选题与第一条视频的完整思路', id: 'dQw4w9WgXcQ' },
  { title: '个人商业的长期主义', text: '把流量变成信任，把经验变成产品', id: 'M7lc1UVf-VE' },
  { title: 'AI 工具与效率工作流', text: '用更少的时间，完成更高质量的表达', id: 'ysz5S6PUM-U' },
];
---

<Layout metadata={metadata}>
  <main class="flybird-page">
    <section class="hero-shell">
      <div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse"></span> FLYBIRD · 小郑</p>
          <h1>把个人经验，<br /><em>变成可持续的增长。</em></h1>
          <p class="hero-lead">专注海外自媒体、个人商业与数字工具。用内容建立信任，用产品创造价值，和一群认真做事的人一起长期成长。</p>
          <div class="hero-actions"><a class="btn btn-primary" href="/tg">开始聊聊 <span>↗</span></a><a class="btn btn-ghost" href="#services">探索我的业务 <span>↓</span></a></div>
          <div class="hero-proof"><div><strong>8+</strong><span>年互联网实战</span></div><div><strong>10K+</strong><span>内容与社群用户</span></div><div><strong>∞</strong><span>持续迭代的热爱</span></div></div>
        </div>
        <div class="hero-card">
          <div class="portrait-frame"><img src="~/assets/images/person_logo.png" alt="FlyBird 小郑" /><div class="portrait-orbit orbit-a"></div><div class="portrait-orbit orbit-b"></div></div>
          <div class="hero-card-note"><span class="status-dot"></span><div><b>正在创造中</b><small>内容 · 社群 · 连接</small></div><span class="arrow">↗</span></div>
        </div>
      </div>
      <div class="scroll-cue"><span></span> 向下探索</div>
    </section>

    <section class="manifesto section-pad"><div class="section-label">/ 01 · MY APPROACH</div><div class="manifesto-grid"><h2>不追逐风口，<br /><span>只做长期有价值的事。</span></h2><div><p>这个网站是我的线上名片，也是我持续记录、分享和连接的地方。这里没有复杂的包装，只有真实的经验、正在做的项目，以及我认为值得一起探索的机会。</p><a class="text-link" href="/about">了解我的故事 <span>→</span></a></div></div></section>

    <section id="services" class="services section-pad"><div class="section-heading"><div><div class="section-label">/ 02 · WHAT I DO</div><h2>我可以怎样<br /><span>帮到你。</span></h2></div><p>如果你也在做内容、做项目，或者正准备开始，我希望这里能给你一些确定的答案和下一步。</p></div><div class="service-grid">{services.map((service) => <a class="service-card" href="/tg"><span class="service-number">{service.number}</span><div><h3>{service.title}</h3><p>{service.text}</p><span class="service-tag">{service.tag}</span></div><span class="card-arrow">↗</span></a>)}</div></section>

    <section class="channel-section section-pad"><div class="channel-copy"><div class="section-label">/ 03 · ON YOUTUBE</div><h2>把复杂的事情，<br /><span>讲得简单一点。</span></h2><p>在 YouTube 上，我分享海外生活、自媒体运营、投资与科技工具。每一期内容都来自真实实践，希望能让你少一点焦虑，多一份行动。</p><a class="btn btn-dark" href="https://www.youtube.com/@Benz_ZH" target="_blank" rel="noreferrer">访问我的频道 <span>↗</span></a></div><div class="video-stack">{videos.map((video, index) => <a class:list={["video-card", { featured: index === 0 }]} href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer"><div class="video-thumb"><img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt={video.title} loading="lazy" /><span class="play">▶</span></div><div><b>{video.title}</b><small>{video.text}</small></div></a>)}</div></section>

    <section class="cta-section"><div class="cta-inner"><div class="section-label">/ 04 · LET'S CONNECT</div><h2>有想法，<em>就现在开始。</em></h2><p>商务合作、内容咨询、社群交流，欢迎找到我。认真对待每一次连接，也期待认识认真做事的你。</p><a class="btn btn-primary" href="/tg">联系 FlyBird 小郑 <span>↗</span></a><div class="cta-links"><a href="https://t.me/flybird_home" target="_blank" rel="noreferrer">Telegram</a><a href="https://www.youtube.com/@Benz_ZH" target="_blank" rel="noreferrer">YouTube</a><a href="/coffee">支持创作</a></div></div></section>
  </main>
</Layout>

<style>
  :global(html){scroll-behavior:smooth}:global(body){background:#f5f4ef;color:#18191b}.flybird-page{font-family:var(--font-family-base,Inter,sans-serif);overflow:hidden}.hero-shell{min-height:calc(100vh - 76px);position:relative;background:#111315;color:#f7f5ef;display:flex;align-items:center}.hero-inner{width:min(1180px,calc(100% - 48px));margin:0 auto;display:grid;grid-template-columns:1.05fr .95fr;gap:6rem;align-items:center;padding:8rem 0 6rem;position:relative;z-index:1}.hero-copy{max-width:650px}.eyebrow,.section-label{font-size:11px;letter-spacing:.22em;font-weight:700;color:#e8a24a}.eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:2rem}.pulse,.status-dot{width:8px;height:8px;border-radius:50%;background:#d7f37a;display:inline-block;box-shadow:0 0 0 5px #d7f37a1c}.hero-copy h1{font-size:clamp(3.4rem,7vw,6.6rem);line-height:.98;letter-spacing:-.07em;margin:0 0 2rem;font-weight:800}.hero-copy h1 em,.manifesto h2 span,.section-heading h2 span,.channel-copy h2 span{font-style:normal;color:#d7f37a}.hero-lead{font-size:1.1rem;line-height:1.8;color:#a8aaad;max-width:570px}.hero-actions{display:flex;gap:12px;margin:2.3rem 0 4.5rem}.btn{display:inline-flex;align-items:center;gap:1.2rem;padding:15px 22px;border-radius:4px;font-size:14px;font-weight:700;transition:transform .2s,background .2s}.btn:hover{transform:translateY(-3px)}.btn-primary{background:#d7f37a;color:#111315}.btn-primary:hover{background:#e5ff91}.btn-ghost{border:1px solid #4b4e51;color:#f7f5ef}.btn-dark{background:#18191b;color:#f7f5ef}.hero-proof{display:flex;gap:3.2rem}.hero-proof div{display:flex;flex-direction:column;gap:7px}.hero-proof strong{font-size:1.65rem;color:#f7f5ef}.hero-proof span{font-size:11px;color:#777b7d}.hero-card{position:relative}.portrait-frame{height:470px;max-width:390px;margin:auto;position:relative;border-radius:220px 220px 10px 10px;background:linear-gradient(145deg,#d7f37a,#849449);overflow:hidden}.portrait-frame:after{content:'';position:absolute;inset:12px;border:1px solid #ffffff55;border-radius:210px 210px 0 0;pointer-events:none}.portrait-frame img{width:100%;height:100%;object-fit:cover;mix-blend-mode:multiply;filter:contrast(1.08);position:relative;z-index:1}.portrait-orbit{position:absolute;border:1px solid #f7f5ef55;border-radius:50%;z-index:2}.orbit-a{width:140%;height:55%;left:-20%;top:25%;transform:rotate(-28deg)}.orbit-b{width:150%;height:65%;left:-25%;top:10%;transform:rotate(34deg)}.hero-card-note{display:flex;align-items:center;gap:13px;background:#232629;border:1px solid #3c4042;padding:15px 18px;position:absolute;bottom:-18px;right:-12px;border-radius:6px;min-width:220px}.hero-card-note b,.hero-card-note small{display:block}.hero-card-note b{font-size:13px}.hero-card-note small{color:#8d9193;font-size:11px;margin-top:3px}.hero-card-note .arrow{margin-left:auto;color:#d7f37a;font-size:20px}.glow-one,.glow-two{position:absolute;border-radius:50%;filter:blur(2px);opacity:.2}.glow-one{width:460px;height:460px;background:#2c563d;right:8%;top:-160px}.glow-two{width:260px;height:260px;background:#6e4b26;left:-100px;bottom:-100px}.scroll-cue{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);font-size:10px;letter-spacing:.15em;color:#777b7d;text-transform:uppercase}.scroll-cue span{display:block;width:1px;height:30px;background:#d7f37a;margin:0 auto 8px}.section-pad{width:min(1180px,calc(100% - 48px));margin:auto;padding:9rem 0}.manifesto{background:#f5f4ef}.manifesto-grid{display:grid;grid-template-columns:1fr 1fr;gap:8rem;margin-top:3.5rem}.manifesto h2,.section-heading h2,.channel-copy h2,.cta-inner h2{font-size:clamp(2.6rem,5vw,5rem);line-height:1.02;letter-spacing:-.06em;margin:0}.manifesto-grid p,.section-heading>p,.channel-copy>p{font-size:1.05rem;line-height:1.9;color:#656866;max-width:470px}.text-link{display:inline-flex;gap:20px;margin-top:1rem;font-weight:700;color:#18191b;border-bottom:1px solid #18191b;padding-bottom:7px}.services{background:#e8e8df}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:3rem;margin-bottom:4rem}.section-heading>p{margin:0}.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#c9cbc1;border:1px solid #c9cbc1}.service-card{background:#e8e8df;padding:2.5rem;display:grid;grid-template-columns:45px 1fr 25px;gap:1.2rem;min-height:235px;transition:background .2s}.service-card:hover{background:#d7f37a}.service-number{font-size:12px;color:#7c817c}.service-card h3{font-size:1.65rem;letter-spacing:-.04em;margin:0 0 1rem}.service-card p{font-size:.95rem;line-height:1.65;color:#656866;max-width:380px}.service-card:hover p{color:#33372d}.service-tag{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#858a82}.card-arrow{font-size:22px}.channel-section{display:grid;grid-template-columns:1fr 1fr;gap:7rem;background:#f5f4ef}.channel-copy p{margin:2rem 0 2.5rem}.video-stack{display:flex;flex-direction:column;gap:14px}.video-card{display:grid;grid-template-columns:150px 1fr;gap:16px;align-items:center;border-bottom:1px solid #d5d5ce;padding-bottom:14px}.video-thumb{height:90px;position:relative;overflow:hidden;border-radius:3px;background:#222}.video-thumb img{width:100%;height:100%;object-fit:cover}.play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:33px;height:33px;border-radius:50%;background:#d7f37a;color:#18191b;display:grid;place-items:center;font-size:11px;padding-left:2px}.video-card b,.video-card small{display:block}.video-card b{font-size:15px}.video-card small{font-size:12px;color:#777b79;line-height:1.5;margin-top:7px}.video-card.featured{grid-template-columns:210px 1fr}.video-card.featured .video-thumb{height:125px}.cta-section{background:#18191b;color:#f7f5ef;padding:9rem 24px}.cta-inner{max-width:820px;margin:auto;text-align:center}.cta-inner h2{margin:1.5rem 0}.cta-inner h2 em{color:#d7f37a;font-style:normal}.cta-inner p{color:#999d9f;line-height:1.8;max-width:510px;margin:0 auto 2.3rem}.cta-links{display:flex;justify-content:center;gap:2rem;margin-top:4rem}.cta-links a{color:#8d9193;font-size:13px}.cta-links a:hover{color:#d7f37a}@media(max-width:800px){.hero-inner,.manifesto-grid,.channel-section{grid-template-columns:1fr;gap:3rem}.hero-inner{padding:6rem 0 5rem}.hero-copy h1{font-size:clamp(3rem,14vw,5rem)}.hero-card{max-width:370px;margin:auto}.portrait-frame{height:390px}.hero-proof{gap:1.4rem}.section-pad{padding:6rem 0}.section-heading{display:block}.section-heading>p{margin-top:1.5rem}.service-grid{grid-template-columns:1fr}.service-card{min-height:0;padding:1.8rem}.channel-section{gap:3rem}.video-card.featured{grid-template-columns:150px 1fr}.video-card.featured .video-thumb{height:90px}.cta-section{padding:6rem 24px}}
</style>
