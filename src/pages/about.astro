---
import Layout from '~/layouts/PageLayout.astro';
const metadata = { title: '关于 FlyBird 小郑', description: '了解 FlyBird 小郑的内容、创业与个人商业实践。' };
const milestones = [
  { year: '2016', title: '开始做内容', text: '从兴趣出发，持续研究平台、内容和用户之间的关系。' },
  { year: '2020', title: '建立自己的业务', text: '将自媒体、数字工具、社群与咨询逐步连接，形成长期服务能力。' },
  { year: 'NOW', title: '持续创造与连接', text: '在 YouTube 分享真实经验，也和更多认真做事的人一起成长。' },
];
---
<Layout metadata={metadata}>
  <main class="inner-page about-page">
    <section class="inner-hero"><p class="eyebrow">/ ABOUT FLYBIRD</p><h1>你好，我是<br /><span>FlyBird 小郑。</span></h1><p>一个长期关注海外自媒体、个人商业和数字工具的内容创作者。我的工作，是把复杂的经验整理成清晰的方法，也把有价值的人连接在一起。</p></section>
    <section class="inner-section story-grid"><div><p class="section-kicker">MY POINT OF VIEW</p><h2>长期主义，<br />从一次认真开始。</h2></div><div class="copy"><p>我相信个人品牌不是包装出来的，而是在一次次交付、分享和兑现承诺中慢慢建立的。这里记录我正在做的事，也欢迎你带着自己的问题来交流。</p><p>无论你正在做 YouTube、准备开始自由职业，还是想搭建自己的线上业务，我希望能提供一些经过实践的参考。</p><a class="inline-link" href="/tg">和我聊聊 →</a></div></section>
    <section class="inner-section timeline"><p class="section-kicker">A SHORT TIMELINE</p>{milestones.map((item)=><div class="timeline-row"><strong>{item.year}</strong><div><h3>{item.title}</h3><p>{item.text}</p></div></div>)}</section>
    <section class="inner-cta"><h2>一起做点有价值的事。</h2><a class="brand-btn" href="/contact">联系合作 ↗</a></section>
  </main>
</Layout>
<style>
.inner-page{background:#f5f4ef;color:#18191b}.inner-hero{background:#18191b;color:#f5f4ef;padding:9rem max(24px,calc((100% - 1180px)/2)) 8rem}.eyebrow,.section-kicker{font-size:11px;letter-spacing:.2em;font-weight:700;color:#b8d95a}.inner-hero h1{font-size:clamp(3.5rem,8vw,7rem);line-height:.95;letter-spacing:-.07em;margin:2rem 0}.inner-hero h1 span{color:#b8d95a}.inner-hero>p:last-child{max-width:580px;color:#a8adaa;font-size:1.15rem;line-height:1.8}.inner-section{max-width:1180px;margin:auto;padding:8rem 24px}.story-grid{display:grid;grid-template-columns:1fr 1fr;gap:8rem}.inner-section h2{font-size:clamp(2.5rem,5vw,5rem);line-height:1;letter-spacing:-.06em;margin:1.5rem 0}.copy{max-width:520px;color:#69706c;font-size:1.05rem;line-height:1.9}.inline-link{display:inline-block;color:#18191b;border-bottom:1px solid #18191b;padding-bottom:5px;font-weight:700;margin-top:1rem}.timeline{border-top:1px solid #d2d3cb}.timeline-row{display:grid;grid-template-columns:180px 1fr;gap:2rem;padding:2.5rem 0;border-bottom:1px solid #d2d3cb}.timeline-row strong{font-size:2rem;color:#a0b746}.timeline-row h3{font-size:1.5rem;margin:0 0 .7rem}.timeline-row p{color:#69706c;margin:0;line-height:1.7}.inner-cta{background:#b8d95a;text-align:center;padding:7rem 24px}.inner-cta h2{font-size:clamp(2.5rem,5vw,5rem);letter-spacing:-.06em;margin:0 0 2rem}.brand-btn{display:inline-block;background:#18191b;color:#f5f4ef;padding:15px 24px;font-weight:700}@media(max-width:700px){.story-grid{grid-template-columns:1fr;gap:2rem}.inner-hero{padding:6rem 24px}.inner-section{padding:5rem 24px}.timeline-row{grid-template-columns:90px 1fr}}
</style>
